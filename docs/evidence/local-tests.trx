      CREATE TABLE "Results" (
          "ResultId" INTEGER NOT NULL CONSTRAINT "PK_Results" PRIMARY KEY AUTOINCREMENT,
          "EnrolmentId" INTEGER NOT NULL,
          "FinishTime" time NOT NULL,
          "OverallPosition" INTEGER NOT NULL,
          "CategoryPosition" INTEGER NOT NULL,
          "RecordedAt" TEXT NOT NULL,
          CONSTRAINT "CK_Results_Positions" CHECK ([OverallPosition] &gt; 0 AND [CategoryPosition] &gt; 0 AND [CategoryPosition] &lt;= [OverallPosition]),
          CONSTRAINT "CK_Results_Time" CHECK ([FinishTime] &gt; '00:00:00'),
          CONSTRAINT "FK_Results_Enrolments_EnrolmentId" FOREIGN KEY ("EnrolmentId") REFERENCES "Enrolments" ("EnrolmentId") ON DELETE RESTRICT
      );
