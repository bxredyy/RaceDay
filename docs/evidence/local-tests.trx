      CREATE TABLE "Users" (
          "UserId" INTEGER NOT NULL CONSTRAINT "PK_Users" PRIMARY KEY AUTOINCREMENT,
          "FullName" TEXT NOT NULL,
          "Email" TEXT NOT NULL,
          "PasswordHash" TEXT NOT NULL,
          "Role" TEXT NOT NULL,
          "PhoneNumber" TEXT NOT NULL,
          "ProfilePictureUrl" TEXT NULL,
          "CreatedAt" datetime2 NOT NULL,
          CONSTRAINT "CK_Users_Role" CHECK ([Role] IN ('Organiser', 'Participant'))
      );
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (0ms) [Parameters=[], CommandType='Text', CommandTimeout='30']
      CREATE TABLE "AuditLogs" (
          "LogId" INTEGER NOT NULL CONSTRAINT "PK_AuditLogs" PRIMARY KEY AUTOINCREMENT,
          "UserId" INTEGER NOT NULL,
          "Action" TEXT NOT NULL,
          "Timestamp" TEXT NOT NULL,
          CONSTRAINT "FK_AuditLogs_Users_UserId" FOREIGN KEY ("UserId") REFERENCES "Users" ("UserId") ON DELETE RESTRICT
      );
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (0ms) [Parameters=[], CommandType='Text', CommandTimeout='30']
      CREATE TABLE "Events" (
          "EventId" INTEGER NOT NULL CONSTRAINT "PK_Events" PRIMARY KEY AUTOINCREMENT,
          "OrganiserId" INTEGER NOT NULL,
          "Name" TEXT NOT NULL,
          "Description" TEXT NOT NULL,
          "EventDate" TEXT NOT NULL,
          "Location" TEXT NOT NULL,
          "DistanceKm" TEXT NOT NULL,
          "EventType" TEXT NOT NULL,
          "BannerImageUrl" TEXT NULL,
          "CreatedAt" TEXT NOT NULL,
          CONSTRAINT "CK_Events_Distance" CHECK ([DistanceKm] &gt; 0),
          CONSTRAINT "CK_Events_Type" CHECK ([EventType] IN ('Run', 'Walk', 'Cycle')),
          CONSTRAINT "FK_Events_Users_OrganiserId" FOREIGN KEY ("OrganiserId") REFERENCES "Users" ("UserId") ON DELETE RESTRICT
      );
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (0ms) [Parameters=[], CommandType='Text', CommandTimeout='30']
      CREATE TABLE "Categories" (
          "CategoryId" INTEGER NOT NULL CONSTRAINT "PK_Categories" PRIMARY KEY AUTOINCREMENT,
          "EventId" INTEGER NOT NULL,
          "CategoryName" TEXT NOT NULL,
          "Description" TEXT NOT NULL,
          "DistanceKm" TEXT NOT NULL,
          "Fee" TEXT NOT NULL,
          CONSTRAINT "AK_Categories_CategoryId_EventId" UNIQUE ("CategoryId", "EventId"),
          CONSTRAINT "CK_Categories_Distance" CHECK ([DistanceKm] &gt; 0),
          CONSTRAINT "CK_Categories_Fee" CHECK ([Fee] &gt;= 0),
          CONSTRAINT "FK_Categories_Events_EventId" FOREIGN KEY ("EventId") REFERENCES "Events" ("EventId") ON DELETE RESTRICT
      );
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
