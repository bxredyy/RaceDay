      CREATE TABLE "Enrolments" (
          "EnrolmentId" INTEGER NOT NULL CONSTRAINT "PK_Enrolments" PRIMARY KEY AUTOINCREMENT,
          "ParticipantId" INTEGER NOT NULL,
          "EventId" INTEGER NOT NULL,
          "CategoryId" INTEGER NOT NULL,
          "EnrolmentDate" TEXT NOT NULL,
          "Status" TEXT NOT NULL DEFAULT 'Confirmed',
          CONSTRAINT "FK_Enrolments_Categories_CategoryId_EventId" FOREIGN KEY ("CategoryId", "EventId") REFERENCES "Categories" ("CategoryId", "EventId") ON DELETE RESTRICT,
          CONSTRAINT "FK_Enrolments_Events_EventId" FOREIGN KEY ("EventId") REFERENCES "Events" ("EventId") ON DELETE RESTRICT,
          CONSTRAINT "FK_Enrolments_Users_ParticipantId" FOREIGN KEY ("ParticipantId") REFERENCES "Users" ("UserId") ON DELETE RESTRICT
      );
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
