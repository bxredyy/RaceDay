@model List<EventDto>
<h2 class="fw-bold mb-3">Upcoming Events</h2>
<form method="get" class="row g-2 mb-4">
    <div class="col-md-4"><input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search..." /></div>
    <div class="col-md-3"><select name="eventType" class="form-select">@foreach (var t in new[] { "All", "Run", "Walk", "Cycle" }) { <option value="@t" selected="@(ViewBag.SelectedType == t)">@t</option> }</select></div>
    <div class="col-md-2"><button class="btn btn-dark w-100">Filter</button></div>
</form>
<div class="row g-4">
    @foreach (var ev in Model)
    {
        <div class="col-md-4"><div class="card h-100">
            @if (!string.IsNullOrEmpty(ev.BannerImageUrl)) { <img src="@ev.BannerImageUrl" class="card-img-top" style="height:180px;object-fit:cover;" /> }
            <div class="card-body d-flex flex-column">
                <span class="badge bg-primary align-self-start mb-2">@ev.EventType</span>
                <h5 class="fw-bold">@ev.Name</h5>
                <p class="text-muted small">@ev.Location - @ev.EventDate.ToString("dd MMM yyyy")</p>
                <p class="small flex-grow-1">@ev.Description</p>
                <a asp-action="Details" asp-route-id="@ev.EventId" class="btn btn-outline-primary mt-2">View &amp; Enter</a>
            </div>
        </div></div>
    }
</div>
