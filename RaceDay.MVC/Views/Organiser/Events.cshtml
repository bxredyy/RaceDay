@model List<EventDto>
<div class="d-flex justify-content-between mb-3"><h2 class="fw-bold">Events</h2><a asp-action="CreateEvent" class="btn btn-primary">+ Create Event</a></div>
<div class="card p-4"><table class="table"><thead><tr><th>Name</th><th>Type</th><th>Date</th><th>Location</th><th></th></tr></thead><tbody>
@foreach (var ev in Model)
{
    <tr><td>@ev.Name</td><td>@ev.EventType</td><td>@ev.EventDate.ToString("dd MMM yyyy")</td><td>@ev.Location</td><td class="text-end"><a asp-action="EditEvent" asp-route-id="@ev.EventId" class="btn btn-sm btn-warning">Edit</a> <form asp-action="DeleteEvent" asp-route-id="@ev.EventId" method="post" class="d-inline"><button class="btn btn-sm btn-danger">Delete</button></form></td></tr>
}
</tbody></table></div>
