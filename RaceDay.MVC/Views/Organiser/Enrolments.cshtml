@model List<EnrolmentDto>
@{ var ev = ViewBag.Event as EventDto; }
<h2 class="fw-bold mb-3">Enrolments - @ev?.Name</h2>
<div class="card p-4"><table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Status</th><th>Date</th></tr></thead><tbody>
@foreach (var e in Model)
{
    var b = e.Status == "Confirmed" ? "bg-success" : (e.Status == "Pending" ? "bg-warning text-dark" : "bg-secondary");
    <tr><td>(@(e.ParticipantName ?? e.ParticipantId.ToString()))</td><td>(@(e.CategoryName ?? e.CategoryId.ToString()))</td><td><span class="badge @b">@e.Status</span></td><td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td></tr>
}
</tbody></table></div>
