@model ResultFormViewModel
@{ var ev = ViewBag.Event as EventDto; var enrolments = ViewBag.Enrolments as List<EnrolmentDto> ?? new(); }
<div class="card p-4 col-md-7"><h3 class="fw-bold mb-3">Results - @ev?.Name</h3>
<form asp-action="Results" method="post">
    <input type="hidden" asp-for="EventId" />
    <div class="mb-3"><label asp-for="EnrolmentId" class="form-label"></label><select asp-for="EnrolmentId" class="form-select">@foreach (var en in enrolments) { <option value="@en.EnrolmentId">(@(en.ParticipantName ?? en.ParticipantId.ToString())) - (@(en.CategoryName ?? en.CategoryId.ToString()))</option> }</select></div>
    <div class="mb-3"><label asp-for="FinishTime" class="form-label"></label><input asp-for="FinishTime" class="form-control" /></div>
    <div class="row g-3 mb-3"><div class="col-md-6"><label asp-for="OverallPosition" class="form-label"></label><input asp-for="OverallPosition" type="number" class="form-control" /></div><div class="col-md-6"><label asp-for="CategoryPosition" class="form-label"></label><input asp-for="CategoryPosition" type="number" class="form-control" /></div></div>
    <button class="btn btn-primary">Save Result</button>
</form></div>
