@model EventFormViewModel
<div class="card p-4 col-md-8"><h3 class="fw-bold mb-3">(@(Model.EventId == 0 ? "Create Event" : "Edit Event"))</h3>
<form asp-action="@(Model.EventId == 0 ? "CreateEvent" : "EditEvent")" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="EventId" /><input type="hidden" asp-for="BannerImageUrl" />
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div>
    <div class="row g-3 mb-3"><div class="col-md-6"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="datetime-local" class="form-control" /></div><div class="col-md-6"><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select></div></div>
    <div class="mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /></div>
    <div class="mb-3"><label asp-for="BannerFile" class="form-label">Banner Image</label><input asp-for="BannerFile" type="file" accept="image/*" class="form-control" /></div>
    <button class="btn btn-primary">Save</button>
</form></div>
