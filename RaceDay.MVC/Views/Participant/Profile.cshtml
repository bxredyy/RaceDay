@model ProfileViewModel
<div class="card p-4 col-md-7"><h3 class="fw-bold mb-3">Profile</h3>
@if (!string.IsNullOrEmpty(Model.ProfilePictureUrl)) { <img src="@Model.ProfilePictureUrl" class="rounded-circle mb-3" style="width:96px;height:96px;object-fit:cover;" /> }
<form asp-action="Profile" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="ProfilePictureUrl" /><input type="hidden" asp-for="Email" /><input type="hidden" asp-for="Role" />
    <div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /></div>
    <div class="mb-3"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /></div>
    <div class="mb-3"><label asp-for="ProfilePictureFile" class="form-label">Profile Picture</label><input asp-for="ProfilePictureFile" type="file" accept="image/*" class="form-control" /></div>
    <button class="btn btn-primary">Save</button>
</form></div>
